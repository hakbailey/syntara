# cp this file to .env (in this directory), fill in the values marked REQUIRED below,
# then load it into your shell before running anything here:
#   set -a; source .env; set +a
# (Sourcing, not just having the file, is what matters — neither podman-compose nor the
# Python scripts in this directory auto-load a .env file from here on their own; sourcing
# puts everything into your shell's exported environment, which both then read from directly.)
# Nothing here is required to have a real value except where noted — everything else
# has a sensible small default (see config.py).

# --- Syntara API auth (matches backend/tools/authz_cli.py's own defaults) ---
# PROTOTYPE_INCIDENT_API_BASE_URL=https://localhost:8000/api/v1  # self-signed cert; api_client.py uses verify=False
# PROTOTYPE_INCIDENT_ADMIN_USERNAME=admin
# PROTOTYPE_INCIDENT_ADMIN_PASSWORD=          # falls back to reading backend/.secrets/admin-password
# APP_ADMIN_PASSWORD_PATH=                    # override only if your secrets file lives somewhere else

# --- incident-mcp-server reachability (see compose.prototype.yml) ---
# Fixed for this prototype, not per-user — read by the syntara/temporal-worker containers
# at startup, so it must be set (via this file) before step 2 in README.md's Run section.
APP_INTEGRATION_URL_ALLOWED_HOSTS='["mcp-server","incident-mcp-server"]'
# PROTOTYPE_INCIDENT_MCP_HOST=incident-mcp-server
# PROTOTYPE_INCIDENT_MCP_PORT=8765

# --- triage workflow's own outbound HTTP nodes calling Syntara's own API (see triage.yaml's
# get_token/trigger_remediation nodes) — also fixed for this prototype, not per-user, and
# also read by the two Temporal worker containers at startup. Confirmed live: without this,
# http_request nodes targeting Syntara's own https://syntara:8000 fail SSRF validation, since
# "syntara" resolves to a private IP.
APP_WORKFLOW_HTTP_REQUEST_ALLOWED_HOSTS='["syntara"]'

# --- volume seed scale (see config.IncidentVolume) ---
# PROTOTYPE_INCIDENT_PROJECTS=10
# PROTOTYPE_INCIDENT_USERS=200
# PROTOTYPE_INCIDENT_SERVICE_ACCOUNTS=20
# PROTOTYPE_INCIDENT_CUSTOM_ROLES=100
# PROTOTYPE_INCIDENT_CUSTOM_POLICIES=100
# PROTOTYPE_INCIDENT_ROLE_ASSIGNMENTS=500
# PROTOTYPE_INCIDENT_GROUPS=20
# PROTOTYPE_INCIDENT_SEED=1337

# --- which action the triage SA is never granted (denied by default; explicit deny
# policies aren't supported by the API yet, see seed_scenario.py) ---
# PROTOTYPE_INCIDENT_DENY_ACTIONS=credential:read

# --- live dependencies (REQUIRED — seed_scenario.py creates the AAP Gateway integration and
# the LLM provider integration/model from these; it exits with an error if they're missing) ---
PROTOTYPE_INCIDENT_AAP_BASE_URL=               # AAP Gateway base URL, e.g. https://aap.example.com
PROTOTYPE_INCIDENT_AAP_TOKEN=                  # AAP OAuth token (or use _AAP_USERNAME + _AAP_PASSWORD)
# PROTOTYPE_INCIDENT_AAP_USERNAME=
# PROTOTYPE_INCIDENT_AAP_PASSWORD=
# PROTOTYPE_INCIDENT_AAP_ALLOW_HTTP=false
# PROTOTYPE_INCIDENT_AAP_INSECURE_SKIP_TLS_VERIFY=false
# PROTOTYPE_INCIDENT_AAP_JOB_TEMPLATE_NAME="Demo Job Template"   # ships by default on every AAP
#   instance; copied (not used directly) into a new job template for this reference task
PROTOTYPE_INCIDENT_AAP_MCP_BASE_URL=            # AAP's own real MCP server URL (a different thing from the AAP Gateway base URL above)
PROTOTYPE_INCIDENT_AAP_MCP_TOKEN=               # bearer token for AAP's MCP server

PROTOTYPE_INCIDENT_LLM_API_KEY=                # provider API key, e.g. an OpenRouter key
PROTOTYPE_INCIDENT_LLM_MODEL_NAME=             # a model id the provider's catalog returns, e.g. anthropic/claude-3.5-sonnet
# PROTOTYPE_INCIDENT_LLM_BASE_URL=https://openrouter.ai/api/v1
# PROTOTYPE_INCIDENT_LLM_PROVIDER_HINT=custom  # one of: red_hat_ai | openai | anthropic | gemini | custom

# --- closing the loop: agent -> approval -> HTTP call triggers remediation ---
# PROTOTYPE_INCIDENT_SYNTARA_INTERNAL_BASE_URL=https://syntara:8000/api/v1
#   URL the triage workflow's own HTTP nodes use to call Syntara's API. Defaults to the
#   compose service name, which only resolves under the FULL containerized stack
#   (`podman-compose up --build`) — not the hybrid `make dev`/`services-up` mode. See README.md.
# PROTOTYPE_INCIDENT_APPROVER_USERNAME=admin
# PROTOTYPE_INCIDENT_APPROVAL_DECISION_WINDOW_SECONDS=3600
